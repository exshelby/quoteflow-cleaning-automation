      "name": "QuoteFlow Workflow Error."
    },
    {
      "parameters": {
        "jsCode": "const execution = $json.execution || {};\nconst workflow = $json.workflow || {};\nconst trigger = $json.trigger || {};\nconst error = execution.error || trigger.error || {};\n\nconst errorMessage =\n  error.message ||\n  execution.message ||\n  trigger.message ||\n  \"Unknown workflow error\";\n\nconst failedNode =\n  execution.lastNodeExecuted ||\n  trigger.lastNodeExecuted ||\n  \"Unknown node\";\n\nreturn {\n  json: {\n    workflowName: workflow.name || \"Unknown workflow\",\n    workflowId: workflow.id || \"\",\n    executionId: execution.id || \"\",\n    executionUrl: execution.url || \"\",\n    executionMode: execution.mode || \"\",\n    failedNode,\n    errorMessage,\n    errorStack: error.stack || \"\",\n    occurredAt: new Date().toISOString(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "7e5170ba-a5b0-4fc0-ae37-a755762d4aa6",
      "name": "Prepare Error Details"
    },
    {
      "parameters": {
        "sendTo": "alerts@example.com",
        "subject": "{{ \"QuoteFlow automation error — \" + $(\"Prepare Error Details\").item.json.workflowName }}",
        "message": "{{ \"<h2>QuoteFlow automation error</h2>\" + \"<p><strong>Workflow:</strong> \" + $(\"Prepare Error Details\").item.json.workflowName + \"</p>\" + \"<p><strong>Failed node:</strong> \" + $(\"Prepare Error Details\").item.json.failedNode + \"</p>\" + \"<p><strong>Error:</strong> \" + $(\"Prepare Error Details\").item.json.errorMessage + \"</p>\" + \"<p><strong>Execution ID:</strong> \" + ($(\"Prepare Error Details\").item.json.executionId || \"Unavailable\") + \"</p>\" + \"<p><strong>Time:</strong> \" + $(\"Prepare Error Details\").item.json.occurredAt + \"</p>\" + ($(\"Prepare Error Details\").item.json.executionUrl ? \"<p><a href=\\\"\" + $(\"Prepare Error Details\").item.json.executionUrl + \"\\\">Open failed execution</a></p>\" : \"\") }}",
        "options": {}
      },
