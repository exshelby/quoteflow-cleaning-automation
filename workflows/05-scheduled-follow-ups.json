    {
      "parameters": {
        "jsCode": "const now = Date.now();\n\nreturn $input.all().filter((item) => {\n  const fields = item.json.fields || {};\n\n  const stage = String(fields[\"Pipeline Stage\"] || \"\").trim();\n  const count = Number(fields[\"Follow-up Count\"] || 0);\n\n  const stopValue = fields[\"Stop Follow-ups\"];\n  const stopped =\n    stopValue === true ||\n    String(stopValue || \"\").toLowerCase() === \"true\";\n\n  const nextActionAt = Date.parse(fields[\"Next Action At\"] || \"\");\n\n  return (\n    [\"Quote Sent\", \"Following Up\"].includes(stage) &&\n    count < 4 &&\n    !stopped &&\n    Number.isFinite(nextActionAt) &&\n    nextActionAt <= now\n  );\n});"
      },
