    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const quote = $(\"Filter Due Follow-Ups\").item.json;\n\nconst previousCount = Number(\n  quote.fields[\"Follow-up Count\"] || 0\n);\n\nconst followUpCount = previousCount + 1;\n\n// Follow-up cadence: 3 days, 7 days, then 14 days.\nconst delayDays = {\n  1: 3,\n  2: 7,\n  3: 14,\n}[followUpCount];\n\nreturn {\n  json: {\n    quoteRecordId: quote.id,\n    requestId: quote.fields[\"Request ID\"],\n    followUpCount,\n    nextActionAt: delayDays\n      ? new Date(Date.now() + delayDays * 86400000).toISOString()\n      : null,\n    stopFollowUps: followUpCount >= 4,\n    gmailMessageId: $json.id || \"\",\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
