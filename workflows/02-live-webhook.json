    {
      "parameters": {
        "jsCode": "const input = $json.body ?? $json;\nconst clean = (value) => String(value ?? '').trim();\nconst phone = clean(input.whatsappNumber || input.phone).replace(/[^0-9+]/g, '');\nconst email = clean(input.email).toLowerCase();\nconst consent = ['true', 'yes', 'on', '1'].includes(clean(input.consent).toLowerCase()) || input.consent === true;\nconst requestId = `QF-${new Date().toISOString().replace(/[-:TZ.]/g, '').slice(0, 14)}-${phone.replace(/\\D/g, '').slice(-4) || 'DEMO'}`;\nconst lead = { requestId, contact: { fullName: clean(input.fullName || input.name), email, whatsappNumber: phone, preferredChannel: 'Both', consent }, job: { serviceType: clean(input.serviceType), propertyType: clean(input.propertyType), serviceAddress: clean(input.serviceAddress), serviceArea: clean(input.serviceArea), propertySize: clean(input.propertySize), cleaningFrequency: clean(input.cleaningFrequency), preferredDate: clean(input.preferredDate), specialRequirements: clean(input.specialRequirements), estimatedValue: Number(input.estimatedValue || 0) }, source: clean(input.source || 'Demo form'), receivedAt: new Date().toISOString() };\nconst required = [['full name', lead.contact.fullName], ['email address', lead.contact.email], ['WhatsApp number', lead.contact.whatsappNumber], ['service type', lead.job.serviceType], ['property type', lead.job.propertyType], ['service address', lead.job.serviceAddress], ['service area or postcode', lead.job.serviceArea], ['property size', lead.job.propertySize], ['cleaning frequency', lead.job.cleaningFrequency], ['preferred date', lead.job.preferredDate]];\nconst missingFields = required.filter(([, value]) => !String(value ?? '').trim()).map(([label]) => label);\nconst invalidFields = [];\nif (lead.contact.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.contact.email)) invalidFields.push('email address');\nif (lead.contact.whatsappNumber && lead.contact.whatsappNumber.replace(/\\D/g, '').length < 8) invalidFields.push('WhatsApp number');\nif (!lead.contact.consent) invalidFields.push('communication consent');\nconst isComplete = missingFields.length === 0 && invalidFields.length === 0;\nlet score = 0;\nconst reasons = [];\nif (lead.job.serviceArea) { score += 20; reasons.push('service area supplied'); }\nif (isComplete) { score += 15; reasons.push('complete request'); }\nif (/weekly|fortnight|monthly|recurr/i.test(lead.job.cleaningFrequency)) { score += 20; reasons.push('recurring service'); }\nif (lead.job.estimatedValue >= 500) { score += 20; reasons.push('strong estimated value'); }\nelse if (lead.job.estimatedValue >= 250) { score += 10; reasons.push('moderate estimated value'); }\nif (lead.job.preferredDate) { score += 15; reasons.push('preferred date supplied'); }\nconst stage = isComplete ? (score >= 40 ? 'Qualified' : 'Manual Review') : 'Awaiting Information';\nconst priority = score >= 70 ? 'Hot' : score >= 40 ? 'Warm' : 'Review';\nconst firstName = lead.contact.fullName.split(/\\s+/)[0] || 'there';\nconst outstanding = [...missingFields, ...invalidFields];\nconst acknowledgement = `Hi ${firstName}, thanks for requesting a quote from BrightNest Cleaning. We received your ${lead.job.serviceType || 'cleaning'} request. Your reference is ${requestId}.`;\nconst nextMessage = outstanding.length ? `We still need: ${outstanding.join(', ')}. Reply with those details and we will continue your request.` : 'Your request is complete. We will send available inspection times shortly.';\nreturn [{ json: { success: true, demoMode: true, message: isComplete ? 'Quote request captured and qualified.' : 'Quote request captured; missing information has been identified.', crmRecord: { ...lead, validation: { isComplete, missingFields, invalidFields }, qualification: { score, priority, reasons, stage }, controls: { followUpCount: 0, stopFollowUps: false, nextActionAt: new Date(Date.now() + (isComplete ? 24 : 6) * 3600000).toISOString() } }, outboundPreview: { email: { to: lead.contact.email, subject: `Cleaning quote request received - ${requestId}`, body: `${acknowledgement}\\n\\n${nextMessage}` }, whatsapp: { to: lead.contact.whatsappNumber, templateKey: outstanding.length ? 'quote_missing_information' : 'quote_acknowledgement', body: `${acknowledgement} ${nextMessage}` } } } }];"
      },
