    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const subject = String($json.Subject || \"\");\n\nconst requestIdMatch = subject.match(\n  /\\bQF-(?:\\d{14}-\\d{4}|\\d+)\\b/i\n);\n\nif (!requestIdMatch) {\n  throw new Error(\"No QuoteFlow Request ID found in the email subject\");\n}\n\nconst from = String($json.From || \"\");\n\nconst senderEmail = (\n  from.match(/<([^>]+)>/)?.[1] || from\n).trim().toLowerCase();\n\nconst snippet = String($json.snippet || \"\");\n\nconst replyText = snippet\n  .split(/\\s+On .*wrote:/i)[0]\n  .replace(/&#39;/g, \"'\")\n  .replace(/&quot;/g, '\"')\n  .replace(/&amp;/g, \"&\")\n  .trim();\n\nconst internalDate = Number(\n  $json.payload?.internalDate || Date.now()\n);\n\nreturn {\n  json: {\n    requestId: requestIdMatch[0].toUpperCase(),\n    senderEmail,\n    replyText,\n    gmailMessageId: $json.id,\n    gmailThreadId: $json.threadId,\n    receivedAt: new Date(internalDate).toISOString(),\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
